<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.2" snapToGrid="false">
  <code><![CDATA[breed [cars car]

cars-own [
  speed
  number
  safe-distance
  original-color
  waiting?
  counted?
  car-type  
]

patches-own [road-type]

globals [
  horizontal-passed  
]

to setup
  ca
  reset-ticks
  set horizontal-passed 0
  
  ask patches [
    set pcolor 63
    set road-type "grass"
  ]
  
  ;; HORIZONTALNE CESTE
  ask patches with [pycor = -1 or pycor = 0 or pycor = 1] [
    set pcolor 5
    set road-type "road"
  ]
  
  ;; VERTIKALNE CESTE - LIJEVO
  ask patches with [pxcor >= -21 and pxcor <= -18 and pycor >= -20 and pycor <= 20] [
    set pcolor 5
    set road-type "road"
  ]
  
  ;; VERTIKALNE BIJELE LINIJE CIJELE DUŽINE - LIJEVO
  ask patches with [pxcor = -19.5 and pycor >= -20 and pycor <= 20] [
    set pcolor 9
  ]

  ;; VERTIKALNE CESTE - SREDINA
  ask patches with [pxcor >= -1 and pxcor <= 2 and pycor >= -20 and pycor <= 20] [
    set pcolor 5
    set road-type "road"
  ]
  
  ;; VERTIKALNE BIJELE LINIJE CIJELE DUŽINE - SREDINA  
  ask patches with [pxcor = 0.5 and pycor >= -20 and pycor <= 20] [
    set pcolor 9
  ]
  
  ;; VERTIKALNE CESTE - DESNO
  ask patches with [pxcor >= 17 and pxcor <= 20 and pycor >= -20 and pycor <= 20] [
    set pcolor 5
    set road-type "road"
  ]
  
  ;; VERTIKALNE BIJELE LINIJE CIJELE DUŽINE - DESNO
  ask patches with [pxcor = 19.5 and pycor >= -20 and pycor <= 20] [
    set pcolor 9
  ]

  ;; KRUŽNI TOKOVI
  ask patches with [pxcor >= -24 and pxcor <= -15 and pycor >= -5 and pycor <= 5] [
    set pcolor 5
    set road-type "roundabout"
  ]
  ask patches with [pxcor >= -4 and pxcor <= 5 and pycor >= -5 and pycor <= 5] [
    set pcolor 5
    set road-type "roundabout"
  ]
  ask patches with [pxcor >= 14 and pxcor <= 23 and pycor >= -5 and pycor <= 5] [
    set pcolor 5
    set road-type "roundabout"
  ]
  
  ;; HORIZONTALNE BIJELE LINIJE CIJELE DUŽINE
  ask patches with [pycor = 0 and (pxcor >= -10 or pxcor <= 10)] [
    set pcolor 6
  ]
  
  ;; DODATNE VERTIKALNE BIJELE LINIJE NA VERTIKALNIM CESTAMA - LEVO
  ask patches with [(pxcor = -20 or pxcor = -19) and pycor >= -10 and pycor <= 10] [
    set pcolor 4
  ]
  
  ;; DODATNE VERTIKALNE BIJELE LINIJE NA VERTIKALNIM CESTAMA - SREDINA
  ask patches with [(pxcor = 0 or pxcor = 1) and pycor >= -10 and pycor <= 10] [
    set pcolor 3
  ]
  
  ;; DODATNE VERTIKALNE BIJELE LINIJE NA VERTIKALNIM CESTAMA - DESNO
  ask patches with [(pxcor = 18 or pxcor = 19) and pycor >= -10 and pycor <= 10] [
    set pcolor 4
  ]
  
  ;; OSTRVA U KRUŽNIM TOKOVIMA
  ask patches with [pxcor >= -22 and pxcor <= -17 and pycor >= -3 and pycor <= 3] [
    set pcolor 53
  ]
  ask patches with [pxcor >= -2 and pxcor <= 3 and pycor >= -3 and pycor <= 3] [
    set pcolor 53
  ]
  ask patches with [pxcor >= 16 and pxcor <= 21 and pycor >= -3 and pycor <= 3] [
    set pcolor 53
  ]
  
  ;; POČETNA AUTA
  make-initial-cars
end

to make-initial-cars
  ;; DONJA HORIZONTALNA LIJEVO
  create-cars 1 [
    setxy -28 -1
    set color red
    set original-color red
    set size 1
    set shape "car top"
    set heading 90
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "horizontal"
  ]
  
  ;; GORNJA HORIZONTALNA DESNO
  create-cars 1 [
    setxy 28 1
    set color blue
    set original-color blue
    set size 1
    set shape "car top"
    set heading 270
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "horizontal"
  ]
  
  ;; LIJEVA GORE
  create-cars 1 [
    setxy -21 18
    set color orange
    set original-color orange
    set size 1
    set shape "car top"
    set heading 180
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "vertical"
  ]
  
  ;; LIJEVA DOLE
  create-cars 1 [
    setxy -18 -18
    set color green
    set original-color green
    set size 1
    set shape "car top"
    set heading 0
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "vertical"
  ]
  
  ;; SREDNJA GORE
  create-cars 1 [
    setxy -1 18
    set color orange
    set original-color orange
    set size 1
    set shape "car top"
    set heading 180
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "vertical"
  ]
  
  ;; SREDNJA DOLE
  create-cars 1 [
    setxy 2 -18
    set color green
    set original-color green
    set size 1
    set shape "car top"
    set heading 0
    set speed 0.15
    set number random 7 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "vertical"
  ]
  
  ;; DESNA GORE
  create-cars 1 [
    setxy 17 18
    set color orange
    set original-color orange
    set size 1
    set shape "car top"
    set heading 180
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "vertical"
  ]
  
  ;; DESNA DOLE
  create-cars 1 [
    setxy 20 -18
    set color green
    set original-color green
    set size 1
    set shape "car top"
    set heading 0
    set speed 0.15
    set number random 5 + 1
    set safe-distance 2.5
    set waiting? true
    set counted? false
    set car-type "vertical"
  ]
end

to go
  ask cars [
    let current-car self
    
    let car-ahead one-of cars-on patch-ahead safe-distance
    let next-patch patch-ahead 1
    
    if next-patch = nobody [
      ifelse heading = 90 [set xcor xcor - 0.5] [fd speed]
    ]
    
    let entering-roundabout? false
    let in-roundabout? ([road-type] of patch-here = "roundabout")
    
    if [road-type] of next-patch = "roundabout" and not in-roundabout? [
      set entering-roundabout? true
    ]
    
    let left-side-clear? true
    if entering-roundabout? [
      let cars-in-roundabout other cars with [
        [road-type] of patch-here = "roundabout" and 
        distance current-car < 5 and
        self != current-car
        and not waiting?
      ]
      
      if count cars-in-roundabout > 0 [
        set left-side-clear? false
      ]
    ]
    
    let can-move1? true
    
    if car-ahead != nobody and distance car-ahead < safe-distance [
      set can-move1? false
    ]
    
    if entering-roundabout? and not left-side-clear? [
      set can-move1? false
    ]
    
    if can-move1? [
      set waiting? false
      set color original-color
      
      if next-patch != nobody and [pcolor] of next-patch = 53 [
        set heading heading + 45
      ]
      
      if next-patch != nobody and [pcolor] of next-patch = 6 and number != 3 [
        set heading heading + 45
      ]
      
      if next-patch != nobody and [pcolor] of next-patch = 4 and number = 3 [
        set heading heading + 45
      ]
      
      if next-patch != nobody and [pcolor] of next-patch = 3 and number = 2 [
        set heading heading + 45
      ]
      
      if next-patch != nobody and [pcolor] of next-patch = 63 [
        set heading heading - 45
      ]
      
      if next-patch != nobody and ([pcolor] of next-patch = 5 or number = 3 or [pcolor] of next-patch = 4 or [pcolor] of next-patch = 3) [
        fd speed
      ]
    ]
    
    if not can-move1? [
      set waiting? true
    ]
    
    if in-roundabout? [
      if next-patch != nobody and ([pcolor] of next-patch = 6 or [pcolor] of next-patch = 4 or [pcolor] of next-patch = 3) [
        if car-ahead = nobody [
          fd speed
        ]
      ]
      if car-ahead = nobody and [pcolor] of next-patch = 5 [
        fd speed
      ]
    ]
    
    ;; BROJANJE AUTOMOBILA
    if heading > 80 and heading < 100 [
      if ycor <= 1 and xcor >= 30 [
        set horizontal-passed horizontal-passed + 1
        set counted? true
      ]
    ]
    
    if heading > 260 and heading < 290 [
      if ycor <= 1 and xcor <= -30 [
        set horizontal-passed horizontal-passed + 1
        set counted? true
      ]
    ]
    
    ;; OBRIŠI AKO JE DALEKO
    if abs xcor > 40 or abs ycor > 25 [
      die
    ]
  ]
  
  ;; KREIRAJ NOVA AUTA - SA OGRANIČENJIMA
  if ticks mod 500 = 0 [
    ;; Broji horizontalne automobile
    let h-car-count count cars with [car-type = "horizontal"]
    
    ;; Kreiraj nove horizontalne automobile ako nema dovoljno
    if h-car-count < horizontal-cars [
      create-cars 1 [
        setxy -28 -1
        set color red
        set original-color red
        set size 1
        set shape "car top"
        set heading 90
        set speed 0.15
        set number random 5 + 1
        set safe-distance 2.5
        set waiting? true
        set counted? false
        set car-type "horizontal"
      ]
      
      create-cars 1 [
        setxy 28 1
        set color blue
        set original-color blue
        set size 1
        set shape "car top"
        set heading 270
        set speed 0.15
        set number random 5 + 1
        set safe-distance 2.5
        set waiting? true
        set counted? false
        set car-type "horizontal"
      ]
    ]
    
    ;; Broji vertikalne automobile
     let v-car-count count cars with [car-type = "vertical"]
    
    ;; Kreiraj nove vertikalne automobile ako nema dovoljno
    if v-car-count < vertical-cars [
      create-cars 1 [
        setxy -21 18
        set color orange
        set original-color orange
        set size 1
        set shape "car top"
        set heading 180
        set speed 0.15
        set number random 5 + 1
        set safe-distance 2.5
        set waiting? true
        set counted? false
        set car-type "vertical"
      ]
      
      create-cars 1 [
        setxy -18 -18
        set color green
        set original-color green
        set size 1
        set shape "car top"
        set heading 0
        set speed 0.15
        set number random 5 + 1
        set safe-distance 2.5
        set waiting? true
        set counted? false
        set car-type "vertical"
      ]
      
      create-cars 1 [
        setxy 17 18
        set color orange
        set original-color orange
        set size 1
        set shape "car top"
        set heading 180
        set speed 0.15
        set number random 5 + 1
        set safe-distance 2.5
        set waiting? true
        set counted? false
        set car-type "vertical"
      ]
      
      create-cars 1 [
        setxy 20 -18
        set color green
        set original-color green
        set size 1
        set shape "car top"
        set heading 0
        set speed 0.15
        set number random 5 + 1
        set safe-distance 2.5
        set waiting? true
        set counted? false
        set car-type "vertical"
      ]
    ]
  ]
  
  tick
end]]></code>
  <widgets>
    <view x="646" wrappingAllowedX="true" y="6" frameRate="30.0" minPycor="-18" height="530" showTickCounter="true" patchSize="14.23" fontSize="10" wrappingAllowedY="true" width="872" tickCounterLabel="ticks" maxPycor="18" updateMode="0" maxPxcor="30" minPxcor="-30"></view>
    <button x="12" y="19" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="63">setup</button>
    <button x="13" y="68" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="63">go</button>
    <note x="81" y="27" backgroundDark="0" fontSize="11" width="150" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">1 tick = 1 sekunda</note>
    <monitor x="255" precision="17" y="30" height="60" fontSize="11" width="100" display="horizontal-passed">horizontal-passed</monitor>
    <slider x="13" step="1" y="119" max="30" width="250" display="horizontal-cars" height="50" min="1" direction="Horizontal" default="30.0" variable="horizontal-cars"></slider>
    <slider x="298" step="1" y="119" max="30" width="250" display="vertical-cars" height="50" min="1" direction="Horizontal" default="17.0" variable="vertical-cars"></slider>
    <plot x="18" autoPlotX="true" yMax="1000.0" autoPlotY="true" yAxis="horizontal-passed" y="198" xMin="0.0" height="252" legend="false" xMax="1000.0" yMin="0.0" width="601" xAxis="Time" display="horizontal cars passed">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot horizontal-passed</update>
      </pen>
    </plot>
  </widgets>
  <info># 4-Way Junction Traffic Simulation (for Sri Lanka) using NetLogo

## WHAT IS IT?

The **4Way Junction Traffic Simulation** is a NetLogo model designed to simulate traffic flow at a four-way intersection. The model aims to represent the dynamics of vehicle movement through an intersection controlled by traffic lights, exploring how various traffic light timings and vehicle behaviors impact overall traffic efficiency and congestion. It is specifically adapted to reflect Sri Lankan road rules and traffic patterns.

## HOW IT WORKS

The model simulates vehicle movement and traffic light control at a four-way intersection. Key elements include:

- **Traffic Lights**: Controlled by dynamic timing adjustments to manage traffic flow.
- **Vehicles**: Move through the intersection according to traffic rules and light signals.
- **Intersection Management**: The model tracks traffic density, vehicle waiting times, and calculates traffic density.
- **Deadlock Detection**: Identifies when all vehicles are stopped or blocked, indicating a deadlock.

The agents (vehicles and traffic lights) use the following rules to create the overall behavior:

- Vehicles move forward based on their current heading and speed.
- Traffic lights change color based on preset timings and traffic conditions.
- Vehicles respond to traffic light changes and other vehicles at the intersection.
- The simulation detects and handles deadlocks by pausing and providing user notifications.

## HOW TO USE IT

To use the model:

1. **Interface Controls**: 
   - **Sliders**: Adjust parameters such as traffic light cycle times, vehicle population, and speed.
   - **Buttons**: Start and stop the simulation.
   - **Monitors**: Display real-time metrics such as total cars, waiting cars, and traffic density.
   - **Input Fields**: Enter preset values for traffic timers, including peak and off-peak times.

2. **Running the Simulation**:
   - Click the **"Setup"** button to initialize the model.
   - Use the **"Go"** button to start the simulation.
   - Adjust sliders and observe how changes affect traffic flow.

## THINGS TO NOTICE

- **Traffic Light Changes**: Watch how different traffic light timings impact vehicle movement and intersection congestion.
- **Deadlock Situations**: Observe scenarios where vehicles become blocked and how the model detects these situations.
- **Vehicle Behavior**: Notice how vehicles respond to traffic lights and other vehicles at the intersection.
- **Performance Impact**: Pay attention to how different speed settings affect the simulation's performance and realism.

## THINGS TO TRY

- **Adjust Traffic Light Timings**: Change the cycle times of traffic lights and observe how it affects traffic flow and congestion.
- **Experiment with Vehicle Density**: Populate roads with different numbers of vehicles and analyze the impact on traffic efficiency.
- **Change Peak and Off-Peak Times**: Modify peak and off-peak timings to see how traffic flow adjusts with varying traffic light schedules.
- **Modify Traffic Cycles**: Adjust the traffic light cycle times and observe the impact on vehicle movement and intersection management.
- **Simulate Different Traffic Scenarios**: Use the model to test various traffic management strategies and observe their effects.

## EXTENDING THE MODEL

To enhance the model further:

- **Add Overtaking Behavior**: Implement vehicle overtaking capabilities to reflect more realistic driving behaviors.
- **Incorporate Pedestrian Crossings**: Include pedestrian traffic and crossing signals to simulate a more comprehensive traffic environment.
- **Expand to Multiple Intersections**: Develop the model to cover a network of intersections for a more complex traffic simulation.
- **Integrate Real-Time Data**: Use real-time traffic data to update the simulation dynamically and improve accuracy.

## NETLOGO FEATURES

The model leverages several interesting NetLogo features:

- **Agent-Based Modeling**: Simulates individual vehicles and traffic lights as agents with specific behaviors.
- **Custom Sliders and Inputs**: Allows dynamic adjustment of parameters such as traffic light timings and vehicle counts.
- **Data Visualization**: Utilizes monitors and plots to visualize traffic metrics and performance.

## RELATED MODELS

- **TrafficBasic** by [Uri Wilensky](https://ccl.northwestern.edu/netlogo/models/TrafficBasic): A foundational model for basic traffic flow.
- **Traffic Grid** by [Uri Wilensky](https://ccl.northwestern.edu/netlogo/models/TrafficGrid): Extends basic traffic simulation to a grid layout.
- **Traffic Intersection** by [Uri Wilensky](https://ccl.northwestern.edu/netlogo/models/TrafficIntersection): Focuses on intersection management.
- **Traffic 2 Lanes** by [Uri Wilensky](https://ccl.northwestern.edu/netlogo/models/Traffic2Lanes): Explores multi-lane traffic dynamics.
- **Traffic Dynamics** by [Francesca De Min](https://ccl.northwestern.edu/netlogo/models/TrafficDynamics) and [Aurora Patetta](https://ccl.northwestern.edu/netlogo/models/TrafficDynamics): Examines complex traffic behaviors.
- **Traffic with Lane Changing** by [Carl Edwards](https://ccl.northwestern.edu/netlogo/models/TrafficWithLaneChanging): Simulates lane changing behaviors.
- **Randi Wakkubura** and **Dr. Budditha Hettige**: Provided context on local traffic management strategies.

## CREDITS AND REFERENCES

- **NetLogo Model Library**: Access and explore related models at [NetLogo Models Library](https://ccl.northwestern.edu/netlogo/models).
- **Uri Wilensky**: Developer of foundational traffic models.
- **Francesca De Min and Aurora Patetta**: Contributors to traffic dynamics research.
- **Carl Edwards**: Creator of lane changing traffic model.
- **Randi Wakkubura and Dr. Budditha Hettige**: Provided insights into local traffic management.

## COPYRIGHT NOTICE

